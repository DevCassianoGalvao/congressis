# Congressis — Apache config

Options -Indexes

# Performance: long-term caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                        "access plus 1 month"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/x-icon            "access plus 1 year"
    ExpiresByType text/css                "access plus 1 month"
    ExpiresByType application/javascript  "access plus 1 month"
    ExpiresByType text/javascript         "access plus 1 month"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# Gzip compression for text assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json text/plain text/xml
</IfModule>

# Servir WebP automaticamente quando browser suporta e arquivo .webp existe
<IfModule mod_rewrite.c>
    RewriteEngine On

    # WebP auto-serve: hero.png → hero.webp (sem duplicar extensão)
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{REQUEST_URI} ^(.+)\.(png|jpe?g)$
    RewriteCond %{DOCUMENT_ROOT}%1.webp -f
    RewriteRule ^(.+)\.(png|jpe?g)$ $1.webp [T=image/webp,E=webp:1,L]

    # Segurança
    RewriteRule ^config/.*$ - [F,L]
    RewriteRule ^logs/.*$   - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header append Vary Accept env=REDIRECT_webp
</IfModule>

AddType image/webp .webp

# Bloquear acesso direto ao config.php independente do caminho
<Files "config.php">
    Order allow,deny
    Deny from all
</Files>

# Proteger o log de erros PHP
<Files "php_errors.log">
    Order allow,deny
    Deny from all
</Files>

# Headers de segurança
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Charset padrão
AddDefaultCharset UTF-8

# Desabilitar assinatura do servidor
ServerSignature Off
